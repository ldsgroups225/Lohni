########################################
# Server
########################################
HOST=0.0.0.0
PORT=5000
VITE_BACKEND_URL=http://localhost:5000

########################################
# Frontend (for CORS / dev server)
########################################
VITE_FRONTEND_URL=http://localhost:5173
VITE_FRONTEND_PORT=5173
VITE_TIMEOUT=90000

########################################
# OpenRouter: every AI call goes through it
########################################
OPENROUTER_API_KEY=sk-or-xxxx
# Text and vision (photos of notebooks). Several models, comma-separated, are tried in order.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5,deepseek/deepseek-v4.1-flash-1017,particle-ai/particle-1:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,openrouter/free
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-large
# Voice transcription (Outils > transcription vocale)
TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
LLM_TEMP=1
# OpenRouter may refuse large values for lack of credits (HTTP 402).
LLM_MAXTOK=3000

########################################
# Podcast voices
########################################
# edge: free Microsoft voices, with OpenRouter as fallback when Edge fails.
# openrouter: always use the OpenRouter model below.
TTS_PROVIDER=edge
FFMPEG_PATH=ffmpeg
TTS_VOICE_EDGE=fr-FR-DeniseNeural
TTS_VOICE_ALT_EDGE=fr-FR-HenriNeural
TTS_MODEL=google/gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
TTS_VOICE_ALT=Charon
